# Server
NODE_ENV=development
PORT=5000
API_URL=/api/v1

# Database
MONGODB_CONNECT=mongodb://localhost:27017
DB_NAME=lifo

# Auth — use a long random string in production
JWT_SECRET=change-me

# CORS — comma-free single origin or * for development
CORS_ORIGIN=*

# Cashfree payment gateway (optional — /order/cftoken returns 503 without it)
CASHFREE_APP_ID=
CASHFREE_APP_SECRET=

# Order-ready email notifications (optional — skipped when unset)
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
